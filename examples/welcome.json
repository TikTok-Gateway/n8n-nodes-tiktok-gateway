{
  "name": "TikTok — Welcome New Follower",
  "nodes": [
    {
      "id": "follower-trigger",
      "name": "New Follower",
      "type": "n8n-nodes-tiktok-gateway.tikTokFollowerTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {},
      "webhookId": "tiktok-follower-gateway"
    },
    {
      "id": "welcome-delay",
      "name": "Wait 1–5 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        260,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ Math.floor(Math.random() * 241) + 60 }}",
        "unit": "seconds"
      }
    },
    {
      "id": "welcome-text",
      "name": "Send Text",
      "type": "n8n-nodes-tiktok-gateway.tikTokText",
      "typeVersion": 1,
      "position": [
        1300,
        0
      ],
      "parameters": {
        "recipient": "={{ $json.userId }}",
        "text": "={{ $json.welcomeText }}",
        "options": {
          "actionKey": "welcome-v1:text-1"
        }
      }
    },
    {
      "id": "welcome-sticker",
      "name": "Send Sticker",
      "type": "n8n-nodes-tiktok-gateway.tikTokSticker",
      "typeVersion": 1,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "recipient": "={{ $json.userId }}",
        "stickerId": "REPLACE_WITH_CATALOG_ID",
        "options": {
          "actionKey": "welcome-v1:sticker-1"
        }
      }
    },
    {
      "id": "shared-welcome",
      "name": "Shared Welcome",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "TikTok Settings"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "welcomeText"
            }
          ]
        },
        "returnAll": false,
        "limit": 2
      },
      "notes": "Read message by name=welcomeText. Edit the shared table. Missing or duplicate names prevent sending."
    },
    {
      "id": "welcome-event",
      "name": "Welcome Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { ...$(\"Wait 1–5 Minutes\").item.json, welcomeText: $json.message } }}",
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "unique-welcome",
      "name": "Valid Welcome Text",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "unique-text",
              "leftValue": "={{ $input.all().length === 1 && typeof $json.message === \"string\" && $json.message.trim().length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "New Follower": {
      "main": [
        [
          {
            "node": "Wait 1–5 Minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 1–5 Minutes": {
      "main": [
        [
          {
            "node": "Shared Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Text": {
      "main": [
        [
          {
            "node": "Send Sticker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shared Welcome": {
      "main": [
        [
          {
            "node": "Valid Welcome Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Welcome Configuration": {
      "main": [
        [
          {
            "node": "Send Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid Welcome Text": {
      "main": [
        [
          {
            "node": "Welcome Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
