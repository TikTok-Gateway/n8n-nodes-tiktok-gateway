{
  "name": "n8n-nodes-tiktok-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Confirmed TikTok Gateway messages and authenticated follower webhooks for n8n",
  "license": "UNLICENSED",
  "author": "TikTok Gateway",
  "keywords": [
    "n8n-community-node-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TikTok-Gateway/n8n-nodes-tiktok-gateway.git"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "dist",
    "scripts/migrate-workflow.cjs",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.cjs",
    "test": "npm run build && node --test test/*.test.js",
    "smoke": "python3 scripts/smoke.py",
    "prepack": "npm run build",
    "format:check": "prettier --check \"nodes/*.ts\" \"credentials/*.ts\" \"test/*.js\" \"test/*.cjs\" \"scripts/*.cjs\""
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.43.2 <3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "2.43.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TikTokGatewayApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TikTokFollowerTrigger.node.js",
      "dist/nodes/TikTokText.node.js",
      "dist/nodes/TikTokSticker.node.js"
    ]
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
